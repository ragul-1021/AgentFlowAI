# AgentFlow AI — backend environment (copy to .env and fill in real values)
#
# DATABASE_URL must use the asyncpg driver and TLS.
# Recommended: Supabase Supavisor SESSION pooler (port 5432), which supports
# prepared statements and IPv4. Do NOT use the transaction pooler (port 6543).
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require

# Optional: separate URL for Alembic migrations. Defaults to DATABASE_URL.
MIGRATION_DATABASE_URL=

# Required later, for AI runs (Phases 3+). Never expose these to the frontend.
GEMINI_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=

# Provider timeouts and retries
GEMINI_TIMEOUT=30.0
GROQ_TIMEOUT=30.0
TAVILY_TIMEOUT=20.0
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
GEMINI_MAX_CONCURRENCY=5
GROQ_MAX_CONCURRENCY=10
TAVILY_MAX_CONCURRENCY=5

# Cost protection (Free-tier only)
FREE_ONLY=true
ALLOW_PAID_MODELS=false
FREE_MODEL_ALLOWLIST=
MAX_REQUEST_TOKENS=8192
TAVILY_MAX_MONTHLY_QUERIES=1000
TAVILY_QUOTA_FILE_PATH=.tavily_quota.json

# Provider Rate & Daily Quotas (Free Tiers)
GEMINI_DAILY_REQUEST_LIMIT=1500
GEMINI_RPM_LIMIT=15
GROQ_DAILY_REQUEST_LIMIT=14400
GROQ_RPM_LIMIT=30
COHERE_MONTHLY_REQUEST_LIMIT=1000
MISTRAL_RPM_LIMIT=60

# Agent Free-Tier Model Assignments (Verified Free Models)
PLANNER_MODEL=gemini-2.5-flash
RESEARCHER_MODEL=gemini-2.5-flash-lite
ANALYST_MODEL=gemini-2.5-flash
WRITER_MODEL=gemini-2.5-flash
REVIEWER_MODEL=gemini-2.5-flash

# Free-tier fallbacks (strictly verified free models)
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GROQ_FALLBACK_MODEL=

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
AI_MOCK_MODE=true
CORS_ORIGINS=http://localhost:5173

# Database pool / timeouts
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=60
DB_STATEMENT_TIMEOUT_MS=60000
DB_IDLE_IN_TX_TIMEOUT_MS=30000

# Not required for the SQLAlchemy/asyncpg integration. Add only if Supabase
# Storage/Auth/PostgREST is adopted later. Service-role keys stay backend-only.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
